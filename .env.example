# ==============================================================================
# TRESERA / TRACERA - Environment Configuration Example
# ==============================================================================
# NOTE: Zero-Friction Local Evaluation:
# The prototype runs out-of-the-box using the high-performance local SQLite WAL
# database stored in `.data/tracera.db` and local file uploads in `/public/uploads`.
# No cloud accounts or keys are required to run and test the complete workflow.
#
# When connecting to production cloud services (MongoDB Atlas, Firebase Storage,
# Google Document AI), populate the credentials below:
# ==============================================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Bootstrap administrator (keep the real password only in .env.local or your
# deployment secret manager; do not commit it). This account is the only
# automatically provisioned ADMIN account.
BOOTSTRAP_ADMIN_EMAIL=your-admin-email@example.com
BOOTSTRAP_ADMIN_PASSWORD=use-a-strong-unique-password

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas (Cloud Database)
# ------------------------------------------------------------------------------
# Provide your MongoDB Atlas replica set URI to sync documents to MongoDB.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/tresera_audit?retryWrites=true&w=majority
MONGODB_DB_NAME=tresera_audit

# ------------------------------------------------------------------------------
# 2. Firebase Client SDK (Client Authentication & Direct Cloud Storage)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef123456

# ------------------------------------------------------------------------------
# 3. Firebase Admin SDK (Server-Side Secure Document Verification)
# ------------------------------------------------------------------------------
FIREBASE_ADMIN_PROJECT_ID=your-firebase-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-app.iam.gserviceaccount.com
# Remember to escape newlines as \n or enclose private key in quotes
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 4. Optional: Google Cloud Document AI (Production Enterprise OCR)
# ------------------------------------------------------------------------------
GOOGLE_DOCUMENT_AI_PROJECT_ID=your-gcp-project-id
GOOGLE_DOCUMENT_AI_LOCATION=us
GOOGLE_DOCUMENT_AI_PROCESSOR_ID=your-processor-id
# Path to service account JSON
GOOGLE_APPLICATION_CREDENTIALS=
